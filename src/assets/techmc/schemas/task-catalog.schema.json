{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "language": {
      "const": "en"
    },
    "lists": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard",
              "expert"
            ]
          },
          "file": {
            "enum": [
              "easy.json",
              "medium.json",
              "hard.json",
              "expert.json"
            ]
          },
          "task_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": [
          "difficulty",
          "file",
          "task_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "language",
    "lists"
  ],
  "additionalProperties": false
}
